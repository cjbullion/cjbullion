<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CJ Bullion | Custom Pure Copper Bars</title>
  <meta name="description" content="CJ Bullion — pure copper bars, standard sizes or made to order. High purity, transparent pricing, direct from the maker.">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            copper: {
              50: '#fdf8f3',
              100: '#f9efe3',
              200: '#f0d9c0',
              300: '#e5bc94',
              400: '#d89a66',
              500: '#c97a3f',
              600: '#b5632f',
              700: '#974d28',
              800: '#7a3f26',
              900: '#653522',
              950: '#361a10',
            },
            dark: {
              900: '#0f0e0d',
              800: '#1a1816',
              700: '#2a2623',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Playfair Display', 'serif'],
          }
        }
      }
    }
  </script>
  <style>
    .copper-gradient {
      background: linear-gradient(135deg, #c97a3f 0%, #e5bc94 50%, #b5632f 100%);
    }
    .hero-bg {
      background: 
        radial-gradient(ellipse at 20% 50%, rgba(201, 122, 63, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 20%, rgba(229, 188, 148, 0.1) 0%, transparent 40%),
        linear-gradient(180deg, #0f0e0d 0%, #1a1816 100%);
    }
    .product-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 50px -12px rgba(201, 122, 63, 0.25);
    }
    .bar-shine {
      background: linear-gradient(110deg, 
        #b5632f 0%, 
        #e5bc94 25%, 
        #c97a3f 50%, 
        #f0d9c0 75%, 
        #b5632f 100%);
      background-size: 200% 100%;
      animation: shine 4s ease-in-out infinite;
    }
    @keyframes shine {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    .cart-badge {
      animation: pulse 2s infinite;
    }
    html { scroll-behavior: smooth; }

#lightbox{display:none;position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.92);align-items:center;justify-content:center;flex-direction:column;padding:1rem}
#lightbox.open{display:flex}
#lightbox .lb-media{max-width:95vw;max-height:75vh;border-radius:12px;object-fit:contain}
#lightbox .lb-close{position:absolute;top:1rem;right:1rem;color:#fff;font-size:2rem;cursor:pointer;line-height:1;background:none;border:none}
#lightbox .lb-thumbs{display:flex;gap:8px;margin-top:1rem;flex-wrap:wrap;justify-content:center}
#lightbox .lb-thumbs img,#lightbox .lb-thumbs video{width:64px;height:64px;object-fit:cover;border-radius:8px;cursor:pointer;border:2px solid transparent;opacity:.7}
#lightbox .lb-thumbs .active{border-color:#c97a3f;opacity:1}


#cj-loader{position:fixed;inset:0;z-index:99999;background:#000;display:flex;align-items:center;justify-content:center;overflow:hidden;transition:opacity .7s ease,visibility .7s}
#cj-loader.hide{opacity:0;visibility:hidden;pointer-events:none}
#cj-loader video{width:100%;height:100%;max-width:100vw;max-height:100vh;object-fit:contain;background:#000}





    
    @keyframes pulse-logo {
      0%, 100% { transform: scale(1); box-shadow: 0 0 30px rgba(201, 122, 63, 0.25); }
      50% { transform: scale(1.06); box-shadow: 0 0 50px rgba(201, 122, 63, 0.45); }
    }
    @keyframes load-bar {
      0% { width: 0%; }
      100% { width: 100%; }
    }
  </style>
</head>
<body class="bg-dark-900 text-gray-100 font-sans antialiased">
<div id="lightbox">
  <button class="lb-close" onclick="closeLightbox()" aria-label="Close">&times;</button>
  <div id="lb-main"></div>
  <div class="lb-thumbs" id="lb-thumbs"></div>
</div>

<div id="cj-loader">
  <video id="intro-vid" autoplay muted playsinline>
    <source src="intro.mp4" type="video/mp4">
  </video>
</div>

<div class="bar"></div>
    <div class="bar"></div>
  </div>
  <div class="txt">CJ Bullion</div>
</div>


  <nav class="fixed top-0 left-0 right-0 z-50 bg-dark-900/90 backdrop-blur-md border-b border-copper-900/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-24">
        <a href="#" class="flex items-center gap-3 group">
          <img src="data:image/jpeg;base64," alt="CJ Bullion" class="h-20 w-20 rounded-full object-cover border border-copper-700/50 shadow-lg group-hover:border-copper-500 transition">
          <span class="font-display text-xl font-bold tracking-tight text-copper-100 group-hover:text-copper-300 transition">CJ Bullion</span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="#gallery" class="text-sm font-medium text-gray-300 hover:text-copper-300 transition">Gallery</a>
          <a href="#why-us" class="text-sm font-medium text-gray-300 hover:text-copper-300 transition">Why Us</a>
          <a href="#pricing" class="text-sm font-medium text-gray-300 hover:text-copper-300 transition">Live Price</a>
          <a href="#contact" class="text-sm font-medium text-gray-300 hover:text-copper-300 transition">Contact</a>
        </div>
        <button id="cart-btn" class="relative p-2 rounded-lg bg-dark-700 hover:bg-copper-900/40 transition group">
          <i class="fas fa-shopping-cart text-copper-300 group-hover:text-copper-200"></i>
          <span id="cart-count" class="absolute -top-1 -right-1 w-5 h-5 bg-copper-500 text-dark-900 text-xs font-bold rounded-full flex items-center justify-center cart-badge hidden">0</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero-bg min-h-screen flex items-center pt-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-copper-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-copper-400 rounded-full blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-copper-900/40 border border-copper-700/50 text-copper-300 text-sm mb-6">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            Custom sizes available · Ships nationwide
          </div>
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight mb-6">
            Pure Copper Bars<br>
            <span class="text-transparent bg-clip-text copper-gradient">Made to Order</span>
          </h1>
          <p class="text-lg text-gray-400 max-w-xl mb-8 leading-relaxed">
            CJ Bullion makes pure copper bars — standard sizes or custom pours. Transparent pricing, high purity, and direct from the maker.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#products" class="px-8 py-3.5 bg-copper-500 hover:bg-copper-400 text-dark-900 font-semibold rounded-xl shadow-lg shadow-copper-500/25 transition transform hover:scale-105">
              Shop Bars
            </a>
            <a href="#pricing" class="px-8 py-3.5 border border-copper-700 hover:border-copper-500 text-copper-200 font-medium rounded-xl transition">
              View Live Price
            </a>
          </div>
          <div class="mt-10 flex items-center gap-6 text-sm text-gray-500">
            <div class="flex items-center gap-2">
              <i class="fas fa-shield-alt text-copper-400"></i>
              <span>Assayed purity</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fas fa-truck text-copper-400"></i>
              <span>Insured shipping</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fas fa-lock text-copper-400"></i>
              <span>Secure checkout</span>
            </div>
          </div>
        </div>
        <div class="relative hidden lg:flex items-center justify-center">
          <div class="relative">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bars" class="w-full max-w-md rounded-2xl object-cover shadow-2xl shadow-copper-900/60 border border-copper-800/40">
            <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 px-4 py-1.5 bg-dark-800/95 border border-copper-700/50 rounded-full backdrop-blur">
              <p class="text-copper-300 font-mono text-sm tracking-widest">Hand-stamped · EST. 2026</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Price Banner -->
  <section id="pricing" class="bg-dark-800 border-y border-copper-900/30 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-copper-900/50 flex items-center justify-center">
            <i class="fas fa-chart-line text-copper-400"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider">Live Copper Spot</p>
            <p class="text-2xl font-bold text-copper-300">$6.30 <span class="text-sm font-normal text-gray-400">/ lb</span></p>
          </div>
        </div>
        <div class="text-sm text-gray-400 text-center sm:text-right">
          <p>Our prices include a small premium over spot + processing.</p>
          <p class="text-xs text-gray-500 mt-1">Updated July 28, 2026 · Prices subject to market fluctuation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Scrolling Photos -->
  
  
  <section id="products" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display text-4xl font-bold mb-3">For Sale</h2>
        <p class="text-gray-400">Available now from CJ Bullion</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-8 max-w-3xl mx-auto">
        <div class="bg-dark-800 rounded-2xl border border-copper-900/40 overflow-hidden shadow-xl flex flex-col">
          <div class="aspect-square bg-dark-900 flex items-center justify-center p-6">
            <img src="data:image/jpeg;base64," alt="CJ Bullion Sticker" class="w-full h-full object-contain" onerror="this.src='https://legendary-choux-da31b6.netlify.app/';">
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="text-xl font-semibold mb-1">CJ Bullion Sticker</h3>
            <p class="text-copper-300 text-2xl font-bold mb-2">$2.00</p>
            <p class="text-sm text-gray-400 mb-4 flex-1">Limited quantity. Get <span class="text-copper-300 font-medium">1 free</span> with every order while supplies last.</p>
            <button onclick="addSticker()" class="w-full text-center py-3 bg-copper-500 hover:bg-copper-400 text-dark-900 font-semibold rounded-xl transition">Add to Cart</button>
          </div>
        </div>
        <div class="bg-dark-800 rounded-2xl border border-copper-900/40 overflow-hidden shadow-xl flex flex-col">
          <div class="aspect-square bg-dark-900 overflow-hidden relative">
            <video src="round-video.mp4" class="w-full h-full object-cover cursor-pointer" autoplay muted loop playsinline onclick="openRoundLightbox()"></video>
            <p class="absolute bottom-2 left-0 right-0 text-center text-xs text-white/80 pointer-events-none">Tap for more</p>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <div class="flex justify-between items-start mb-1">
              <h3 class="text-xl font-semibold">High Relief Copper Round</h3>
              <span class="text-xs bg-copper-900/60 text-copper-300 px-2 py-0.5 rounded-full">Limited quantity</span>
            </div>
            <p class="text-xs text-gray-500 mb-1">CJ Bullion / GravenMade · .9999 Cu</p>
            <p class="text-copper-300 text-2xl font-bold mb-2">$25.00</p>
            <p class="text-sm text-gray-400 mb-4 flex-1">Detailed high-relief copper round. Reaper with balloons design.</p>
            <button onclick="addRound()" class="w-full text-center py-3 bg-copper-500 hover:bg-copper-400 text-dark-900 font-semibold rounded-xl transition">Add to Cart</button>
          </div>
        </div>
      </div>
    </div>
  </section>


<section id="gallery" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <img src="data:image/jpeg;base64," alt="CJ Bullion" class="w-48 h-48 rounded-full mx-auto mb-6 border-2 border-copper-700/50 object-cover shadow-xl">
        <h2 class="font-display text-4xl font-bold mb-3">Our Copper Bars</h2>
        <p class="text-gray-400 max-w-xl mx-auto">Scroll to see the bars · Hand-stamped with the CJ Bullion mark</p>
      </div>
    </div>
    <div class="relative">
      <div class="flex gap-4 overflow-x-auto pb-6 px-4 sm:px-8 snap-x snap-mandatory scrollbar-thin" style="scrollbar-width: thin;">
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 1" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 2" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 3" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 4" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 5" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 6" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 7" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 8" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 9" class="w-full h-full object-cover">
          </div>
        </div>
        <div class="flex-shrink-0 w-72 sm:w-80 snap-center">
          <div class="rounded-2xl overflow-hidden border border-copper-900/40 shadow-lg aspect-[4/5]">
            <img src="data:image/jpeg;base64," alt="CJ Bullion copper bar 10" class="w-full h-full object-cover">
          </div>
        </div>
      </div>
      <p class="text-center text-sm text-gray-500 mt-4">← Swipe or scroll →</p>
    </div>
  </section>

  <!-- Why Us -->
  <section id="why-us" class="py-24 bg-dark-800/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <img src="data:image/jpeg;base64," alt="CJ Bullion" class="w-48 h-48 rounded-full mx-auto mb-6 border-2 border-copper-700/50 object-cover shadow-xl">
        <h2 class="font-display text-4xl font-bold mb-4">Why Buy From CJ Bullion?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">Custom copper bars made to order.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-dark-700/50 border border-copper-900/20 hover:border-copper-700/40 transition">
          <div class="w-12 h-12 rounded-xl bg-copper-900/40 flex items-center justify-center mb-5">
            <i class="fas fa-fire text-copper-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-semibold mb-3">Custom Sizes</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Want a specific weight or size? Just ask — we make custom copper bars to order.</p>
        </div>
        <div class="p-8 rounded-2xl bg-dark-700/50 border border-copper-900/20 hover:border-copper-700/40 transition">
          <div class="w-12 h-12 rounded-xl bg-copper-900/40 flex items-center justify-center mb-5">
            <i class="fas fa-balance-scale text-copper-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-semibold mb-3">Transparent Pricing</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Prices track the live copper market. No hidden fees. You always know what you’re paying relative to spot.</p>
        </div>
        <div class="p-8 rounded-2xl bg-dark-700/50 border border-copper-900/20 hover:border-copper-700/40 transition">
          <div class="w-12 h-12 rounded-xl bg-copper-900/40 flex items-center justify-center mb-5">
            <i class="fas fa-box-open text-copper-400 text-xl"></i>
          </div>
          <h3 class="text-xl font-semibold mb-3">Secure & Insured</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Heavy-duty packaging, full insurance, and tracked shipping. Your copper arrives safely — no more handoffs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl font-bold mb-4">How It Works</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-14 h-14 mx-auto rounded-full bg-copper-500/20 border border-copper-500/40 flex items-center justify-center text-copper-300 font-bold text-xl mb-4">1</div>
          <h3 class="font-semibold mb-2">Choose or request</h3>
          <p class="text-sm text-gray-400">Pick a standard size or request a custom bar.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 mx-auto rounded-full bg-copper-500/20 border border-copper-500/40 flex items-center justify-center text-copper-300 font-bold text-xl mb-4">2</div>
          <h3 class="font-semibold mb-2">Add to cart</h3>
          <p class="text-sm text-gray-400">See exact pricing based on today’s market rate.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 mx-auto rounded-full bg-copper-500/20 border border-copper-500/40 flex items-center justify-center text-copper-300 font-bold text-xl mb-4">3</div>
          <h3 class="font-semibold mb-2">Checkout securely</h3>
          <p class="text-sm text-gray-400">Pay via card or bank transfer. We confirm within hours.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 mx-auto rounded-full bg-copper-500/20 border border-copper-500/40 flex items-center justify-center text-copper-300 font-bold text-xl mb-4">4</div>
          <h3 class="font-semibold mb-2">Receive your copper</h3>
          <p class="text-sm text-gray-400">Insured shipping, usually 2–5 business days.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact / Order note -->
  <section id="contact" class="py-24 bg-dark-800/50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <img src="data:image/jpeg;base64," alt="CJ Bullion" class="w-48 h-48 rounded-full mx-auto mb-6 border-2 border-copper-700/50 object-cover shadow-xl">
      <h2 class="font-display text-4xl font-bold mb-4">Ready to Order?</h2>
      <p class="text-gray-400 mb-4">Standard bars ship fast. Want a custom size or weight? Message us and we’ll make it.</p>
      <p class="mb-8 flex flex-wrap justify-center gap-6">
        <a href="https://www.instagram.com/copperjunglebullion/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-copper-300 hover:text-copper-200 transition">
          <i class="fab fa-instagram text-xl"></i>
          <span>Instagram</span>
        </a>
        <a href="https://www.tiktok.com/@copperjunglebullion" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-copper-300 hover:text-copper-200 transition">
          <i class="fab fa-tiktok text-xl"></i>
          <span>TikTok</span>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61576116927892" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-copper-300 hover:text-copper-200 transition">
          <i class="fab fa-facebook text-xl"></i>
          <span>Facebook</span>
        </a>
      </p>
      <div class="bg-dark-700 rounded-2xl p-8 border border-copper-900/30 text-left">
        <h3 class="font-semibold text-lg mb-4 text-copper-300">Contact / Custom Orders</h3>
        <form id="contact-form" class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <input type="text" placeholder="Your name" class="w-full px-4 py-3 bg-dark-800 border border-copper-900/40 rounded-xl focus:outline-none focus:border-copper-500 text-sm" required>
            <input type="email" placeholder="Email address" class="w-full px-4 py-3 bg-dark-800 border border-copper-900/40 rounded-xl focus:outline-none focus:border-copper-500 text-sm" required>
          </div>
          <textarea rows="4" placeholder="Message or custom order (desired weight, size, shipping location...)" class="w-full px-4 py-3 bg-dark-800 border border-copper-900/40 rounded-xl focus:outline-none focus:border-copper-500 text-sm" required></textarea>
          <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-copper-500 hover:bg-copper-400 text-dark-900 font-semibold rounded-xl transition">
            Send Message
          </button>
        </form>
        <p id="form-success" class="hidden mt-4 text-green-400 text-sm">Thanks! In a real site this would go to your inbox. For now it’s just a demo.</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-copper-900/30 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-2">
          <img src="data:image/jpeg;base64," alt="CJ Bullion" class="h-24 w-24 rounded-full object-cover border border-copper-700/40">
          <span class="font-display font-bold text-copper-100">CJ Bullion</span>
        </div>
        <p class="text-sm text-gray-500">© 2026 CJ Bullion. Custom copper bars made to order.</p>
        <div class="flex gap-4 text-gray-500">
          <a href="https://www.instagram.com/copperjunglebullion/" target="_blank" rel="noopener" class="hover:text-copper-400 transition text-2xl" title="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="https://www.tiktok.com/@copperjunglebullion" target="_blank" rel="noopener" class="hover:text-copper-400 transition text-2xl" title="TikTok"><i class="fab fa-tiktok"></i></a>
          <a href="https://www.facebook.com/profile.php?id=61576116927892" target="_blank" rel="noopener" class="hover:text-copper-400 transition text-2xl" title="Facebook"><i class="fab fa-facebook"></i></a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Cart Drawer -->
  <div id="cart-drawer" class="fixed inset-y-0 right-0 w-full max-w-md bg-dark-800 border-l border-copper-900/40 z-50 transform translate-x-full transition-transform duration-300 shadow-2xl">
    <div class="flex flex-col h-full">
      <div class="flex items-center justify-between p-5 border-b border-copper-900/30">
        <h3 class="font-semibold text-lg">Your Cart</h3>
        <button id="close-cart" class="p-2 hover:bg-dark-700 rounded-lg transition">
          <i class="fas fa-times text-gray-400"></i>
        </button>
      </div>
      <div id="cart-items" class="flex-1 overflow-y-auto p-5 space-y-4">
        <p class="text-gray-500 text-sm text-center py-10">Your cart is empty</p>
      </div>
      <div class="p-5 border-t border-copper-900/30 overflow-y-auto max-h-[50vh]">
        <div class="flex justify-between text-sm mb-1">
          <span class="text-gray-400">Subtotal</span>
          <span id="cart-subtotal" class="text-gray-300">$0.00</span>
        </div>
        <div class="flex justify-between text-sm mb-3">
          <span class="text-gray-400">Shipping (USPS Priority)</span>
          <span id="cart-shipping" class="text-gray-300">$0.00</span>
        </div>
        <div class="flex justify-between mb-4">
          <span class="text-gray-400">Total</span>
          <span id="cart-total" class="font-bold text-copper-300">$0.00</span>
        </div>

        <form id="address-form-wrap" class="hidden space-y-2 mb-4" name="order" method="POST" data-netlify="true" netlify netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="order">
          <input type="hidden" name="bot-field">
          <input type="hidden" name="items" id="form-items">
          <input type="hidden" name="subtotal" id="form-subtotal">
          <input type="hidden" name="shipping" id="form-shipping">
          <input type="hidden" name="total" id="form-total">
          <p class="text-xs text-copper-300 font-medium mb-1">Shipping address</p>
          <input type="text" name="name" id="ship-name" placeholder="Full name" class="w-full px-3 py-2 bg-dark-900 border border-copper-900/40 rounded-lg text-sm focus:outline-none focus:border-copper-500" required>
          <input type="email" name="email" id="ship-email" placeholder="Email" class="w-full px-3 py-2 bg-dark-900 border border-copper-900/40 rounded-lg text-sm focus:outline-none focus:border-copper-500" required>
          <input type="text" name="address" id="ship-address" placeholder="Street address" class="w-full px-3 py-2 bg-dark-900 border border-copper-900/40 rounded-lg text-sm focus:outline-none focus:border-copper-500" required>
          <div class="grid grid-cols-2 gap-2">
            <input type="text" name="city" id="ship-city" placeholder="City" class="w-full px-3 py-2 bg-dark-900 border border-copper-900/40 rounded-lg text-sm focus:outline-none focus:border-copper-500" required>
            <input type="text" name="state" id="ship-state" placeholder="State" class="w-full px-3 py-2 bg-dark-900 border border-copper-900/40 rounded-lg text-sm focus:outline-none focus:border-copper-500" required>
          </div>
          <input type="text" name="zip" id="ship-zip" placeholder="ZIP code" class="w-full px-3 py-2 bg-dark-900 border border-copper-900/40 rounded-lg text-sm focus:outline-none focus:border-copper-500" required>
        </form>

        <button id="checkout-btn" class="w-full py-3 bg-copper-500 hover:bg-copper-400 text-dark-900 font-semibold rounded-xl transition disabled:opacity-40 disabled:cursor-not-allowed" disabled>
          Continue to shipping
        </button>
        <p class="text-xs text-gray-500 text-center mt-3">PayPal · USPS Priority</p>
      </div>
    </div>
  </div>
  <div id="cart-overlay" class="fixed inset-0 bg-black/60 z-40 hidden"></div>

  



<script>
(function(){
  var loader = document.getElementById('cj-loader');
  var vid = document.getElementById('intro-vid');
  function hide(){ if(loader) loader.classList.add('hide'); }
  if(vid){
    vid.addEventListener('ended', hide);
    // safety timeout in case video fails
    setTimeout(hide, 6000);
  } else {
    setTimeout(hide, 500);
  }
})();
</script>





<script>
(function(){
  var cart = [];
  var step = 1;
  var SHIP_STICKER = 2;
  var SHIP_BAR = 9;

  function money(n){ return '$' + n.toFixed(2); }
  function hasBars(){ return cart.some(function(i){ return i.id !== 'sticker'; }); }
  function shipCost(){
    if(cart.length === 0) return 0;
    return hasBars() ? SHIP_BAR : SHIP_STICKER;
  }

  function update(){
    var count = cart.reduce(function(s,i){ return s + i.qty; }, 0);
    var el = document.getElementById('cart-count');
    if(el){
      if(count > 0){ el.textContent = count; el.classList.remove('hidden'); }
      else el.classList.add('hidden');
    }
    var items = document.getElementById('cart-items');
    var subEl = document.getElementById('cart-subtotal');
    var shipEl = document.getElementById('cart-shipping');
    var totalEl = document.getElementById('cart-total');
    var btn = document.getElementById('checkout-btn');
    var formWrap = document.getElementById('address-form-wrap');
    if(!items) return;

    if(cart.length === 0){
      items.innerHTML = '<p class="text-gray-500 text-sm text-center py-10">Your cart is empty</p>';
      if(subEl) subEl.textContent = '$0.00';
      if(shipEl) shipEl.textContent = '$0.00';
      if(totalEl) totalEl.textContent = '$0.00';
      if(btn){ btn.disabled = true; btn.textContent = 'Continue to shipping'; }
      if(formWrap) formWrap.classList.add('hidden');
      step = 1;
      return;
    }

    var subtotal = 0;
    items.innerHTML = cart.map(function(item){
      subtotal += item.price * item.qty;
      return '<div class="flex gap-3 items-center bg-dark-700/50 rounded-xl p-3">' +
        '<div class="flex-1"><p class="font-medium text-sm">' + item.name + '</p>' +
        '<p class="text-xs text-gray-500">' + money(item.price) + ' each</p>' +
        '<div class="flex items-center gap-2 mt-1">' +
        '<button type="button" onclick="changeQty(\'' + item.id + '\',-1)" class="w-7 h-7 rounded bg-dark-800 text-sm">−</button>' +
        '<span class="text-sm w-5 text-center">' + item.qty + '</span>' +
        '<button type="button" onclick="changeQty(\'' + item.id + '\',1)" class="w-7 h-7 rounded bg-dark-800 text-sm">+</button></div></div>' +
        '<div class="text-right"><p class="text-sm text-copper-300">' + money(item.price*item.qty) + '</p>' +
        '<button type="button" onclick="removeItem(\'' + item.id + '\')" class="text-xs text-gray-500 hover:text-red-400">Remove</button></div></div>';
    }).join('');

    var ship = shipCost();
    var total = subtotal + ship;
    if(subEl) subEl.textContent = money(subtotal);
    if(shipEl) shipEl.textContent = money(ship) + (hasBars() ? '–$18.00' : '');
    if(totalEl) totalEl.textContent = money(total);
    if(btn) btn.disabled = false;
    window._cartTotal = total;
    window._cartSubtotal = subtotal;
    window._cartShip = ship;
    window._cartNote = cart.map(function(i){ return i.qty + 'x ' + i.name; }).join(', ');
  }

  window.addRound = function(){
    var existing = cart.find(function(i){ return i.id === 'round'; });
    if(existing) existing.qty++;
    else cart.push({ id:'round', name:'High Relief Copper Round', price:25, qty:1 });
    update();
    openCart();
  };
  window.addSticker = function(){
    var existing = cart.find(function(i){ return i.id === 'sticker'; });
    if(existing) existing.qty++;
    else cart.push({ id:'sticker', name:'CJ Bullion Sticker', price:2, qty:1 });
    update();
    openCart();
  };
  window.changeQty = function(id, d){
    var item = cart.find(function(i){ return i.id === id; });
    if(!item) return;
    item.qty = Math.max(1, item.qty + d);
    update();
  };
  window.removeItem = function(id){
    cart = cart.filter(function(i){ return i.id !== id; });
    update();
  };
  function openCart(){
    var d = document.getElementById('cart-drawer');
    var o = document.getElementById('cart-overlay');
    if(d) d.classList.remove('translate-x-full');
    if(o) o.classList.remove('hidden');
  }
  function closeCart(){
    var d = document.getElementById('cart-drawer');
    var o = document.getElementById('cart-overlay');
    if(d) d.classList.add('translate-x-full');
    if(o) o.classList.add('hidden');
  }

  function submitOrderThenPay(){
    var form = document.getElementById('address-form-wrap');
    var name = document.getElementById('ship-name').value.trim();
    var email = document.getElementById('ship-email').value.trim();
    var address = document.getElementById('ship-address').value.trim();
    var city = document.getElementById('ship-city').value.trim();
    var state = document.getElementById('ship-state').value.trim();
    var zip = document.getElementById('ship-zip').value.trim();

    if(!name || !email || !address || !city || !state || !zip){
      alert('Please fill in all shipping fields.');
      return;
    }

    // fill hidden fields
    document.getElementById('form-items').value = window._cartNote;
    document.getElementById('form-subtotal').value = window._cartSubtotal.toFixed(2);
    document.getElementById('form-shipping').value = window._cartShip.toFixed(2);
    document.getElementById('form-total').value = window._cartTotal.toFixed(2);

    // Submit to Netlify Forms via fetch so we can then open PayPal
    var fd = new FormData(form);
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(fd).toString()
    }).then(function(){
      // open PayPal
      var url = 'https://paypal.me/chrissquadrito/' + window._cartTotal.toFixed(2);
      window.open(url, '_blank');
      if(window.__cjDecrementStock){
        var dec = cart.map(function(i){ return { id: i.id, qty: i.qty }; });
        window.__cjDecrementStock(dec);
      }
      alert('Order submitted! Complete payment in PayPal.

Put your name in the PayPal note so we can match your order.');
      cart = [];
      step = 1;
      form.classList.add('hidden');
      document.getElementById('checkout-btn').textContent = 'Continue to shipping';
      form.reset();
      update();
      closeCart();
    }).catch(function(){
      // still open PayPal even if form fails
      var url = 'https://paypal.me/chrissquadrito/' + window._cartTotal.toFixed(2);
      window.open(url, '_blank');
      alert('Please complete PayPal payment. Also message us your address if needed.');
    });
  }

  document.addEventListener('DOMContentLoaded', function(){
    var cartBtn = document.getElementById('cart-btn');
    var closeBtn = document.getElementById('close-cart');
    var overlay = document.getElementById('cart-overlay');
    var checkout = document.getElementById('checkout-btn');
    var formWrap = document.getElementById('address-form-wrap');
    if(cartBtn) cartBtn.addEventListener('click', openCart);
    if(closeBtn) closeBtn.addEventListener('click', closeCart);
    if(overlay) overlay.addEventListener('click', closeCart);

    if(checkout) checkout.addEventListener('click', function(){
      if(cart.length === 0) return;
      if(step === 1){
        if(formWrap) formWrap.classList.remove('hidden');
        checkout.textContent = 'Pay with PayPal';
        step = 2;
        return;
      }
      submitOrderThenPay();
    });
    update();
  });
})();
</script>





<!-- Netlify Forms detection -->
<form name="order" netlify netlify-honeypot="bot-field" hidden>
  <input type="text" name="name">
  <input type="email" name="email">
  <input type="text" name="address">
  <input type="text" name="city">
  <input type="text" name="state">
  <input type="text" name="zip">
  <input type="text" name="items">
  <input type="text" name="subtotal">
  <input type="text" name="shipping">
  <input type="text" name="total">
  <input type="text" name="bot-field">
</form>


<script>
window.openRoundLightbox = function(){
  var lb = document.getElementById('lightbox');
  var main = document.getElementById('lb-main');
  var thumbs = document.getElementById('lb-thumbs');
  if(!lb) return;
  var still = "data:image/jpeg;base64,";
  function showVideo(){
    main.innerHTML = '<video class="lb-media" src="round-video.mp4" controls autoplay muted loop playsinline></video>';
  }
  function showStill(){
    main.innerHTML = '<img class="lb-media" src="' + still + '" alt="Copper Round">';
  }
  showVideo();
  thumbs.innerHTML = '';
  var t1 = document.createElement('video');
  t1.src = 'round-video.mp4'; t1.muted = true; t1.className = 'active';
  t1.onclick = function(){ showVideo(); thumbs.querySelectorAll('*').forEach(function(x){x.classList.remove('active')}); t1.classList.add('active'); };
  var t2 = document.createElement('img');
  t2.src = still;
  t2.onclick = function(){ showStill(); thumbs.querySelectorAll('*').forEach(function(x){x.classList.remove('active')}); t2.classList.add('active'); };
  thumbs.appendChild(t1);
  thumbs.appendChild(t2);
  lb.classList.add('open');
};
window.closeLightbox = function(){
  var lb = document.getElementById('lightbox');
  if(lb) lb.classList.remove('open');
  var main = document.getElementById('lb-main');
  if(main) main.innerHTML = '';
};
document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeLightbox(); });
document.addEventListener('DOMContentLoaded', function(){
  var lb = document.getElementById('lightbox');
  if(lb) lb.addEventListener('click', function(e){ if(e.target.id === 'lightbox') closeLightbox(); });
});
</script>


<script>
(function(){
  var stock = { round: 1, sticker: 50 };
  var STOCK_URL = '/.netlify/functions/stock';

  function refreshProductUI(){
    // Round button
    var roundBtn = document.querySelector('button[onclick="addRound()"]');
    var roundBadge = document.querySelector('#products .grid > div:nth-child(2) .rounded-full');
    if(roundBtn){
      if((stock.round || 0) <= 0){
        roundBtn.disabled = true;
        roundBtn.textContent = 'Sold Out';
        roundBtn.classList.add('opacity-50','cursor-not-allowed');
        if(roundBadge) roundBadge.textContent = 'Sold Out';
      } else {
        roundBtn.disabled = false;
        roundBtn.textContent = 'Add to Cart';
        roundBtn.classList.remove('opacity-50','cursor-not-allowed');
        if(roundBadge) roundBadge.textContent = 'Limited quantity';
      }
    }
    // Sticker
    var stickerBtn = document.querySelector('button[onclick="addSticker()"]');
    if(stickerBtn){
      if((stock.sticker || 0) <= 0){
        stickerBtn.disabled = true;
        stickerBtn.textContent = 'Sold Out';
        stickerBtn.classList.add('opacity-50','cursor-not-allowed');
      } else {
        stickerBtn.disabled = false;
        stickerBtn.textContent = 'Add to Cart';
        stickerBtn.classList.remove('opacity-50','cursor-not-allowed');
      }
    }
  }

  function loadStock(){
    fetch(STOCK_URL).then(function(r){ return r.json(); }).then(function(data){
      if(data && typeof data.round === 'number') stock = data;
      refreshProductUI();
    }).catch(function(){ refreshProductUI(); });
  }

  window.decrementStock = function(items){
    // items: [{id:'round', qty:1}, ...]
    var chain = Promise.resolve();
    (items || []).forEach(function(it){
      var key = it.id === 'round' ? 'round' : (it.id === 'sticker' ? 'sticker' : null);
      if(!key) return;
      chain = chain.then(function(){
        return fetch(STOCK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ item: key, qty: it.qty || 1 })
        }).then(function(r){ return r.json(); }).then(function(data){
          if(data && data.stock) stock = data.stock;
          refreshProductUI();
        });
      });
    });
    return chain;
  };

  window.getStock = function(){ return stock; };

  // Wrap addRound/addSticker after they exist — poll briefly
  var tries = 0;
  var t = setInterval(function(){
    tries++;
    if(typeof window.addRound === 'function' || tries > 40){
      clearInterval(t);
      var _addRound = window.addRound;
      var _addSticker = window.addSticker;
      if(_addRound){
        window.addRound = function(){
          if((stock.round || 0) <= 0){ alert('Sold out'); return; }
          _addRound();
        };
      }
      if(_addSticker){
        window.addSticker = function(){
          if((stock.sticker || 0) <= 0){ alert('Sold out'); return; }
          _addSticker();
        };
      }
      loadStock();
    }
  }, 100);

  // After successful order, decrement — hook into existing submit
  var _origFetch = window.fetch;
  // Patch is fragile; instead expose and call from cart script
  window.__cjLoadStock = loadStock;
  window.__cjDecrementStock = window.decrementStock;
  document.addEventListener('DOMContentLoaded', loadStock);
})();
</script>

</body>
</html>
